{
	"name": "edmat-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check:katex": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/check_katex_compatibility.ts",
		"check:a11y": "tsx scripts/check_accessibility.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/dompurify": "^3.0.5",
		"@types/leaflet": "^1.9.21",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.12.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright-core": "^1.62.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.101.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"@tiptap/core": "^2.27.3",
		"@tiptap/extension-image": "^2.27.3",
		"@tiptap/extension-link": "^2.27.3",
		"@tiptap/extension-table": "^2.27.3",
		"@tiptap/extension-table-cell": "^2.27.3",
		"@tiptap/extension-table-header": "^2.27.3",
		"@tiptap/extension-table-row": "^2.27.3",
		"@tiptap/starter-kit": "^2.27.3",
		"dompurify": "^3.2.4",
		"events": "^3.3.0",
		"isomorphic-dompurify": "^3.20.0",
		"jsqr": "^1.4.0",
		"katex": "^0.16.11",
		"ketcher-core": "^3.18.0",
		"ketcher-react": "^3.18.0",
		"ketcher-standalone": "^3.18.0",
		"leaflet": "^1.9.4",
		"markdown-it": "^14.1.0",
		"pdfjs-dist": "^6.2.108",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"svelte-easy-crop": "^5.0.1"
	}
