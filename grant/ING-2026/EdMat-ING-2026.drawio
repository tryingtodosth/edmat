<mxfile host="drawio-lasso" modified="2026-09-16T19:15:31Z" agent="build_deck.py" version="31.3.2" type="device" pages="15"><diagram id="c364" name="1 Tytuł"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c304" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c305" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c1" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;PROGRAM GRANTOWY ING „W RYTMIE POKOLEŃ” · 9. EDYCJA · LIGA SEED&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=19;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="200" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c2" value="EdMat.net" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=96;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="900" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Zadania z rozwiązaniami, które sprawdzają ludzie —&lt;br&gt;od matury do emerytury.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=40;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="392" width="880" height="160" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Otwarta baza zadań i społeczność uczących się w każdym wieku. Działa pod &lt;b&gt;edmat.net&lt;/b&gt;, kod otwarty (MIT), 745 zadań ze zweryfikowanymi rozwiązaniami.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=27;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="570" width="860" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;Zespół młodych naukowców&lt;/b&gt;&lt;br&gt;Wydział Fizyki Uniwersytetu Warszawskiego · wrzesień 2026&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="860" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D5DBE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1032" y="228" width="816" height="516" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1040" y="236" width="800" height="500" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#5B6470&quot;&gt;Strona główna edmat.net, 16 września 2026 — pasma wiekowe od najmłodszych po seniorów.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1040" y="760" width="800" height="40" as="geometry"/></mxCell><mxCell id="c306" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c307" value="1 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c365" name="2 Problem"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c308" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c309" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;PROBLEM&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Dobra edukacja ścisła nie ma dziś w Polsce miejsca,&lt;br&gt;w którym jest sprawdzana, otwarta i trwała&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="554" height="470" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Student przed egzaminem&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=30;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="290" width="490" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;line-height:1.38&quot;&gt;Zadania i rozwiązania są rozproszone po PDF-ach, stronach kursów i grupach na czacie. Strona przedmiotu znika po semestrze. Nikt nie odpowiada nazwiskiem za to, czy rozwiązanie jest poprawne.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=25;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="360" width="490" height="350" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="682" y="260" width="554" height="470" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Uczeń i rodzic&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=30;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="714" y="290" width="490" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;line-height:1.38&quot;&gt;Brainly i ChatGPT dają odpowiedź w sekundę — często błędną, bez wyjaśnienia i bez nikogo, kto by ją sprawdził. Uczeń uczy się sam przed ekranem; rodzic nie ma bezpiecznego miejsca dla dziecka poniżej 16 lat.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=25;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="714" y="360" width="490" height="350" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1264" y="260" width="554" height="470" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Emerytowany nauczyciel&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=30;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1296" y="290" width="490" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;line-height:1.38&quot;&gt;Trzydzieści lat rozwiązanych zadań w szufladzie i nikt, kto by o nie zapytał. Serwisy „dla seniorów” oferują gry na pamięć, nie rolę.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=25;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1296" y="360" width="490" height="350" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="770" width="1720" height="150" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Wspólny mianownik:&lt;/b&gt; wiedza o tym, &lt;b&gt;jak&lt;/b&gt; rozwiązać zadanie, nie jest w Polsce zebrana w jednym miejscu, nie jest recenzowana i nie przechodzi między pokoleniami. To nie jest problem braku treści — jest problem braku mechanizmu.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=27;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="796" width="1656" height="110" as="geometry"/></mxCell><mxCell id="c310" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c311" value="2 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c366" name="3 Wizja i start"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c312" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c313" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;WIZJA — I GDZIE ZACZYNAMY&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Chcemy zmienić edukację ścisłą w Polsce.&lt;br&gt;Zaczynamy tu, i wiemy dlaczego.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="262" width="800" height="640" as="geometry"/></mxCell><mxCell id="c25" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Chcemy&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="136" y="296" width="730" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;div style=&quot;line-height:1.38&quot;&gt;Żeby każde zadanie ze szkoły i studiów miało w jednym otwartym miejscu rozwiązanie, za które ktoś ręczy nazwiskiem — i żeby ta wiedza przechodziła między pokoleniami: od doktoranta do maturzysty, od emerytowanej nauczycielki do wnuka.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=30;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="136" y="346" width="730" height="300" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;span style=&quot;color:#5B6470&quot;&gt;Ten sam mechanizm otwieramy kolejno: maturzyści (2027) → dorośli zmieniający zawód → seniorzy i finanse osobiste.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="136" y="700" width="730" height="170" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="262" width="880" height="640" as="geometry"/></mxCell><mxCell id="c29" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Zaczynamy od&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#B4530A;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="976" y="296" width="800" height="60" as="geometry"/></mxCell><mxCell id="c30" value="&lt;div style=&quot;line-height:1.2&quot;&gt;studentów kierunków ścisłych UW&lt;br&gt;przed egzaminem&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=32;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="976" y="346" width="800" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 14px 0&quot;&gt;&lt;b&gt;Mamy treści:&lt;/b&gt; 745 zadań z dwóch przedmiotów UW (Analiza Matematyczna II, Rachunek Prawdopodobieństwa I), 742 ze zweryfikowanym rozwiązaniem.&lt;/li&gt;&lt;li style=&quot;margin:0 0 14px 0&quot;&gt;&lt;b&gt;Mamy ludzi:&lt;/b&gt; kadrę i doktorantów Wydziału Fizyki, którzy recenzują — opieka naukowa prof. Katarzyny Grabowskiej (KMMF).&lt;/li&gt;&lt;li style=&quot;margin:0 0 14px 0&quot;&gt;&lt;b&gt;Mamy pierwszy mierzalny test:&lt;/b&gt; sesja zimowa 2026/27 — cel: 300 aktywnych studentów.&lt;/li&gt;&lt;li style=&quot;margin:0 0 14px 0&quot;&gt;&lt;b&gt;Najwęższy klin z realnym dostępem&lt;/b&gt; — a nie „miliard użytkowników”.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=25;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="976" y="470" width="800" height="420" as="geometry"/></mxCell><mxCell id="c314" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c315" value="3 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c367" name="4 Przypadek 1: Ola"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c316" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c317" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c32" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;PRZYPADEK UŻYCIA 1 — DZIAŁA DZIŚ&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c33" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Ola, II rok fizyki, pięć dni do kolokwium z Analizy II&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c34" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="252" width="46" height="46" as="geometry"/></mxCell><mxCell id="c35" value="&lt;div style=&quot;line-height:1.33&quot;&gt;Wchodzi na edmat.net → Matematyka → Analiza matematyczna; filtruje dział „całki” i poziom „trudne”.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="166" y="250" width="690" height="100" as="geometry"/></mxCell><mxCell id="c36" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="46" height="46" as="geometry"/></mxCell><mxCell id="c37" value="&lt;div style=&quot;line-height:1.33&quot;&gt;Próbuje sama. Treść jest widoczna, rozwiązanie nie — odsłania się stopniowo.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="166" y="358" width="690" height="100" as="geometry"/></mxCell><mxCell id="c38" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="468" width="46" height="46" as="geometry"/></mxCell><mxCell id="c39" value="&lt;div style=&quot;line-height:1.33&quot;&gt;Utknęła: odsłania wskazówkę, potem odpowiedź, na końcu rozwiązanie ze znakiem ✓ zweryfikowane i głosami innych.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="166" y="466" width="690" height="100" as="geometry"/></mxCell><mxCell id="c40" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="576" width="46" height="46" as="geometry"/></mxCell><mxCell id="c41" value="&lt;div style=&quot;line-height:1.33&quot;&gt;Nie rozumie kroku 3 — pyta w dyskusji pod rozwiązaniem. Odpowiada doktorant albo emerytowana nauczycielka.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="166" y="574" width="690" height="100" as="geometry"/></mxCell><mxCell id="c42" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="684" width="46" height="46" as="geometry"/></mxCell><mxCell id="c43" value="&lt;div style=&quot;line-height:1.33&quot;&gt;Dodaje 12 zadań do „Mój zestaw” i drukuje arkusz do PDF.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="166" y="682" width="690" height="100" as="geometry"/></mxCell><mxCell id="c44" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="792" width="46" height="46" as="geometry"/></mxCell><mxCell id="c45" value="&lt;div style=&quot;line-height:1.33&quot;&gt;Po kolokwium dodaje własne, krótsze rozwiązanie — trafia do recenzji, po akceptacji do puli.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="166" y="790" width="690" height="100" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D5DBE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="892" y="242" width="936" height="591" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="920" height="575" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E5F6EC;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="920" height="96" as="geometry"/></mxCell><mxCell id="c49" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#146E3B&quot;&gt;&lt;b&gt;Wszystko na tym slajdzie działa dziś na edmat.net&lt;/b&gt; — zrzut z 16 września 2026: wskazówka i odpowiedź odsłonięte, matematyka renderowana (KaTeX).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=19;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="924" y="866" width="876" height="76" as="geometry"/></mxCell><mxCell id="c318" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c319" value="4 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c368" name="5 Seniorzy w trzech rolach"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c320" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c321" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c50" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;PRZYPADEK UŻYCIA 2 — DLA TEJ EDYCJI NAJWAŻNIEJSZY&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c51" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Seniorzy w trzech rolach — nie tylko „pani Halina”&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="1720" height="92" as="geometry"/></mxCell><mxCell id="c53" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;Seniorzy nie chcą „korzystać z innowacji”. Chcą roli i powodu.&lt;/b&gt; Dajemy im obie rzeczy — i przeglądarkę, nic więcej. Trzy role, bo emerytowani matematycy to promil seniorów, a doświadczenie życiowe mają wszyscy.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="266" width="1656" height="70" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="368" width="557" height="470" as="geometry"/></mxCell><mxCell id="c55" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Recenzent zadań&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=26;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="128" y="392" width="501" height="44" as="geometry"/></mxCell><mxCell id="c56" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#5B6470&quot;&gt;emerytowani nauczyciele i wykładowcy przedmiotów ścisłych — nieliczni, ale wiemy, gdzie są&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=19;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="128" y="438" width="501" height="80" as="geometry"/></mxCell><mxCell id="c57" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;pani Halina, 68 lat, emerytowana nauczycielka matematyki: recenzuje rozwiązania z matury i I roku — jej nazwisko stoi za każdym&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;odpowiada uczniom w dyskusjach; po miesiącu opiekunka działu „matura”&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;sama rozwiązuje trudne zadania — sprawność umysłu w rygorze, nie w „grach na pamięć”&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="128" y="522" width="501" height="310" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="681" y="368" width="557" height="470" as="geometry"/></mxCell><mxCell id="c59" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Czytelnik-tester&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=26;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="709" y="392" width="501" height="44" as="geometry"/></mxCell><mxCell id="c60" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#5B6470&quot;&gt;każdy senior: słuchacze UTW, bywalcy bibliotek — bez wiedzy wyższej&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=19;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="709" y="438" width="501" height="80" as="geometry"/></mxCell><mxCell id="c61" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;czy wskazówka jest zrozumiała? czy tłumaczenie brzmi po polsku? czy zadanie z podstawówki ma sens?&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;recenzuje treści dla najmłodszych i pasma „szkoła podstawowa”&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;uczy się sam: kurs „matura od nowa”, zadania w swoim tempie, duża czcionka&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="709" y="522" width="501" height="310" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1262" y="368" width="557" height="470" as="geometry"/></mxCell><mxCell id="c63" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Współautor finansów osobistych&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=26;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1290" y="392" width="501" height="44" as="geometry"/></mxCell><mxCell id="c64" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#5B6470&quot;&gt;każdy senior z doświadczeniem życiowym — czyli każdy&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=19;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1290" y="438" width="501" height="80" as="geometry"/></mxCell><mxCell id="c65" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;współtworzy i recenzuje moduł finansów: budżet domowy, bezpieczne oszczędzanie, oszustwa „na wnuczka” i na BLIK&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;uczy się od młodych ekonomistów o emeryturze, IKE/IKZE, inflacji — wymiana w obie strony&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;dzieli się historią, której nie ma w żadnym podręczniku&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1290" y="522" width="501" height="310" as="geometry"/></mxCell><mxCell id="c66" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;Lejek, uczciwie:&lt;/b&gt; 125,9 tys. słuchaczy UTW to nie recenzenci analizy. Recenzentów szukamy tam, gdzie są: emerytowana kadra Wydziału Fizyki i MIM UW, sekcje emerytów ZNP w 3 miastach, licea partnerskie. Cel pilotażu: 30 seniorów, w tym co najmniej 10 recenzentów zadań; jeśli po 3 miesiącach jest ich mniej, role 2 i 3 niosą pilotaż dalej. 20% grantu, w tym animator społeczności seniorów (½ etatu).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="858" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c322" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c323" value="5 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c369" name="6 Co już działa"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c324" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c325" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c67" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;STAN DZIŚ&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c68" value="&lt;div style=&quot;line-height:1.15&quot;&gt;To nie pomysł — produkt. Działa pod edmat.net od lipca 2026&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c69" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="412" height="224" as="geometry"/></mxCell><mxCell id="c70" value="&lt;div style=&quot;line-height:1.05&quot;&gt;745&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=54;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="124" y="272" width="364" height="80" as="geometry"/></mxCell><mxCell id="c71" value="&lt;div style=&quot;line-height:1.25&quot;&gt;zadań z pełnymi rozwiązaniami — Analiza Matematyczna II i Rachunek Prawdopodobieństwa I (UW)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=21;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="124" y="346" width="364" height="118" as="geometry"/></mxCell><mxCell id="c72" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="536" y="250" width="412" height="224" as="geometry"/></mxCell><mxCell id="c73" value="&lt;div style=&quot;line-height:1.05&quot;&gt;742&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;v