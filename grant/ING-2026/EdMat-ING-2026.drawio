yle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1434" y="640" width="360" height="30" as="geometry"/></mxCell><mxCell id="c153" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;pilotaż w 3 miastach: 30 seniorów, animator społeczności&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;moduł finansów 60+: emerytura, oszczędzanie, oszustwa&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1434" y="670" width="360" height="210" as="geometry"/></mxCell><mxCell id="c154" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Pasmo wiekowe to pole na każdej treści i filtr na każdej liście: dziesięciolatek i emerytka nie widzą tego samego ekranu — ale wnuk i babcia pracują na tym samym zadaniu.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="912" width="1720" height="60" as="geometry"/></mxCell><mxCell id="c334" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c335" value="8 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c372" name="9 Finanse i AI"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c336" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c337" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c155" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;DWA OBSZARY EDYCJI — KONKRETNIE, NIE JAKO HASŁO&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c156" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Edukacja finansowa i sztuczna inteligencja&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c157" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="846" height="680" as="geometry"/></mxCell><mxCell id="c158" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Finanse osobiste w rytmie pokoleń&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=28;fontColor=#B4530A;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="278" width="782" height="50" as="geometry"/></mxCell><mxCell id="c159" value="&lt;div style=&quot;line-height:1.33&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Dział „Finanse osobiste” już istnieje na edmat.net.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Kurs autorski młodych ekonomistów (Natalia Prus): budżet, procent składany, kredyt, IKE/IKZE, inflacja, podatki — jako &lt;b&gt;zadania z rozwiązaniami&lt;/b&gt; sprawdzanymi tak samo jak zadania z analizy.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Seniorzy współtworzą i recenzują: budżet domowy, bezpieczne oszczędzanie, oszustwa „na wnuczka” i na BLIK — doświadczenie, którego nie ma w podręczniku.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Materiały polecane, np. blog Marcina Iwucia — prosty język, bez sprzedaży produktów.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Moduł dla maturzystów (pierwsze własne pieniądze) i dla seniorów (emerytura, oszczędzanie, cyberoszustwa) — prowadzony przez ludzi, którym ufają.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="340" width="782" height="580" as="geometry"/></mxCell><mxCell id="c160" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="974" y="250" width="846" height="680" as="geometry"/></mxCell><mxCell id="c161" value="&lt;div style=&quot;line-height:1.3&quot;&gt;AI ugruntowane w tym, co sprawdzili ludzie&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=28;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1006" y="278" width="782" height="50" as="geometry"/></mxCell><mxCell id="c162" value="&lt;div style=&quot;line-height:1.33&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Nie budujemy własnego modelu.&lt;/b&gt; Budujemy warstwę, której modelom brakuje: weryfikację.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Podpowiedzi sokratejskie: AI wybiera wskazówkę z rozwiązań zweryfikowanych przez ludzi — nigdy nie generuje rozwiązania „z głowy”. To jedyna praca nad AI w grancie.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Generator sprawdzianów dla nauczyciela: unikalne zestawy z bazy, z rozwiązaniami sprawdzonymi przez ludzi — funkcja, za którą szkoła lub rada rodziców zapłaci symboliczny abonament.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Wstępne sortowanie kolejki moderacji: duplikaty, brakujące kroki, podejrzane obrazki.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Szkice tłumaczeń PL / EN / UK z zachowaniem LaTeX: model danych gotowy — faza 2, po walidacji rdzenia.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;Sami budujemy z agentami AI — wiemy, co potrafią i gdzie kłamią.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1006" y="340" width="782" height="580" as="geometry"/></mxCell><mxCell id="c338" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c339" value="9 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c373" name="10 Konkurencja"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c340" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c341" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c163" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;KONKURENCJA&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c164" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Znamy ją, bo z niej korzystaliśmy przed każdym egzaminem&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c165" value="KTO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#5B6470;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="244" width="330" height="40" as="geometry"/></mxCell><mxCell id="c166" value="CO DAJE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#5B6470;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="244" width="600" height="40" as="geometry"/></mxCell><mxCell id="c167" value="CZEGO NIE DAJE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#5B6470;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="244" width="790" height="40" as="geometry"/></mxCell><mxCell id="c168" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="88" y="280" width="1744" height="66" as="geometry"/></mxCell><mxCell id="c169" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;Brainly, Zadane.pl&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="286" width="314" height="60" as="geometry"/></mxCell><mxCell id="c170" value="&lt;div style=&quot;line-height:1.25&quot;&gt;odpowiedź do pracy domowej w sekundę&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="286" width="584" height="60" as="geometry"/></mxCell><mxCell id="c171" value="&lt;div style=&quot;line-height:1.25&quot;&gt;weryfikacji; jest za to reklama; poziom szkolny&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="286" width="774" height="60" as="geometry"/></mxCell><mxCell id="c172" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;ChatGPT i podobne&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="356" width="314" height="60" as="geometry"/></mxCell><mxCell id="c173" value="&lt;div style=&quot;line-height:1.25&quot;&gt;dostępność od ręki, każdy temat&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="356" width="584" height="60" as="geometry"/></mxCell><mxCell id="c174" value="&lt;div style=&quot;line-height:1.25&quot;&gt;pewności — w zadaniach ścisłych regularnie błędne, bez znajomości programu; podaje wynik zamiast prowadzić&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="356" width="774" height="60" as="geometry"/></mxCell><mxCell id="c175" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="88" y="420" width="1744" height="66" as="geometry"/></mxCell><mxCell id="c176" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;Khan Academy&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="426" width="314" height="60" as="geometry"/></mxCell><mxCell id="c177" value="&lt;div style=&quot;line-height:1.25&quot;&gt;świetne wideo na poziomie szkolnym&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="426" width="584" height="60" as="geometry"/></mxCell><mxCell id="c178" value="&lt;div style=&quot;line-height:1.25&quot;&gt;polskich zadań uczelnianych, społeczności, języka polskiego&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="426" width="774" height="60" as="geometry"/></mxCell><mxCell id="c179" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;Kampus (Moodle), LMS&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="496" width="314" height="60" as="geometry"/></mxCell><mxCell id="c180" value="&lt;div style=&quot;line-height:1.25&quot;&gt;materiały prowadzącego dla jego kursu&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="496" width="584" height="60" as="geometry"/></mxCell><mxCell id="c181" value="&lt;div style=&quot;line-height:1.25&quot;&gt;otwartości — zamknięte per kurs, znikają po semestrze; bez puli rozwiązań&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="496" width="774" height="60" as="geometry"/></mxCell><mxCell id="c182" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="88" y="560" width="1744" height="66" as="geometry"/></mxCell><mxCell id="c183" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;Librus, Vulcan&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="566" width="314" height="60" as="geometry"/></mxCell><mxCell id="c184" value="&lt;div style=&quot;line-height:1.25&quot;&gt;dziennik i komunikacja ze szkołą&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="566" width="584" height="60" as="geometry"/></mxCell><mxCell id="c185" value="&lt;div style=&quot;line-height:1.25&quot;&gt;treści do nauki — to nie jest ich zadanie&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="566" width="774" height="60" as="geometry"/></mxCell><mxCell id="c186" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;Math StackExchange&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="636" width="314" height="60" as="geometry"/></mxCell><mxCell id="c187" value="&lt;div style=&quot;line-height:1.25&quot;&gt;wysoka jakość odpowiedzi&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="636" width="584" height="60" as="geometry"/></mxCell><mxCell id="c188" value="&lt;div style=&quot;line-height:1.25&quot;&gt;języka polskiego, mapowania na program, formy do nauki przed egzaminem&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="636" width="774" height="60" as="geometry"/></mxCell><mxCell id="c189" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="88" y="700" width="1744" height="66" as="geometry"/></mxCell><mxCell id="c190" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;e-korepetycje.net, Preply&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="706" width="314" height="60" as="geometry"/></mxCell><mxCell id="c191" value="&lt;div style=&quot;line-height:1.25&quot;&gt;rynek korepetytorów&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="430" y="706" width="584" height="60" as="geometry"/></mxCell><mxCell id="c192" value="&lt;div style=&quot;line-height:1.25&quot;&gt;treści — korepetycje bez zadań, które można razem przerobić&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="706" width="774" height="60" as="geometry"/></mxCell><mxCell id="c193" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E5F6EC;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="770" width="1720" height="176" as="geometry"/></mxCell><mxCell id="c194" value="&lt;div style=&quot;line-height:1.38&quot;&gt;&lt;span style=&quot;color:#146E3B&quot;&gt;&lt;b&gt;Tylko EdMat — i to już działa:&lt;/b&gt;&lt;/span&gt; ✓ zweryfikowane rozwiązania jako mechanizm &amp;nbsp; ✓ treść zmapowana na program &amp;nbsp; ✓ wersje językowe treści recenzowane osobno &amp;nbsp; ✓ wszystkie pokolenia z bezpiecznymi ustawieniami domyślnymi &amp;nbsp; ✓ kod otwarty, bez reklam&lt;br&gt;&lt;b&gt;Fosa to nie kod (MIT).&lt;/b&gt; To zweryfikowana baza zmapowana na polski program, reputacja recenzentów i społeczność, która ją tworzy. Brainly czy OpenAI mogą dodać przycisk „zweryfikowane” w rok; nie mają ludzi, którzy ręczą za rozwiązanie nazwiskiem — a tych się nie kupuje, tych się buduje.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=21;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="786" width="1656" height="150" as="geometry"/></mxCell><mxCell id="c342" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c343" value="10 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c374" name="11 Odbiorcy"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c344" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c345" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c195" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;ODBIORCY I SKALA&lt;/span&gt;" style="text;html=1;strokeColor=none;fillC