eft;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="620" height="84" as="geometry"/></mxCell><mxCell id="c239" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="560" height="30" as="geometry"/></mxCell><mxCell id="c240" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="560" height="30" as="geometry"/></mxCell><mxCell id="c241" value="&lt;div style=&quot;line-height:1.15&quot;&gt;&lt;b&gt;35%&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#5B6470&quot;&gt;157 tys. zł&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1340" y="256" width="240" height="40" as="geometry"/></mxCell><mxCell id="c242" value="&lt;div style=&quot;line-height:1.22&quot;&gt;Rozwój produktu — podpowiedzi AI ugruntowane w puli, generator sprawdzianów dla nauczycieli, prosta kolejka recenzji dla seniorów&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="342" width="620" height="84" as="geometry"/></mxCell><mxCell id="c243" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="352" width="560" height="30" as="geometry"/></mxCell><mxCell id="c244" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="352" width="400" height="30" as="geometry"/></mxCell><mxCell id="c245" value="&lt;div style=&quot;line-height:1.15&quot;&gt;&lt;b&gt;25%&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#5B6470&quot;&gt;112 tys. zł&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1340" y="348" width="240" height="40" as="geometry"/></mxCell><mxCell id="c246" value="&lt;div style=&quot;line-height:1.22&quot;&gt;Pilotaż międzypokoleniowy — 3 miasta, 30 seniorów w 3 rolach, animator społeczności (½ etatu), rekrutacja przez ZNP, UTW i emerytowaną kadrę UW&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="434" width="620" height="84" as="geometry"/></mxCell><mxCell id="c247" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="560" height="30" as="geometry"/></mxCell><mxCell id="c248" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B4530A;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="320" height="30" as="geometry"/></mxCell><mxCell id="c249" value="&lt;div style=&quot;line-height:1.15&quot;&gt;&lt;b&gt;20%&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#5B6470&quot;&gt;90 tys. zł&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1340" y="440" width="240" height="40" as="geometry"/></mxCell><mxCell id="c250" value="&lt;div style=&quot;line-height:1.22&quot;&gt;Infrastruktura, bezpieczeństwo, prawo — serwery, audyt, fundacja, RODO dla kont dzieci, wnioski grantowe&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="526" width="620" height="84" as="geometry"/></mxCell><mxCell id="c251" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="536" width="560" height="30" as="geometry"/></mxCell><mxCell id="c252" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="536" width="160" height="30" as="geometry"/></mxCell><mxCell id="c253" value="&lt;div style=&quot;line-height:1.15&quot;&gt;&lt;b&gt;10%&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#5B6470&quot;&gt;45 tys. zł&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1340" y="532" width="240" height="40" as="geometry"/></mxCell><mxCell id="c254" value="&lt;div style=&quot;line-height:1.22&quot;&gt;Badania z użytkownikami — 60 wywiadów i testów, dwie rundy przed każdym wdrożeniem&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="618" width="620" height="84" as="geometry"/></mxCell><mxCell id="c255" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="628" width="560" height="30" as="geometry"/></mxCell><mxCell id="c256" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="628" width="80" height="30" as="geometry"/></mxCell><mxCell id="c257" value="&lt;div style=&quot;line-height:1.15&quot;&gt;&lt;b&gt;5%&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#5B6470&quot;&gt;23 tys. zł&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1340" y="624" width="240" height="40" as="geometry"/></mxCell><mxCell id="c258" value="&lt;div style=&quot;line-height:1.22&quot;&gt;Promocja i społeczność — kampania z prof. Andrzejem Draganem, wydarzenia na UW i w szkołach&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="710" width="620" height="84" as="geometry"/></mxCell><mxCell id="c259" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="560" height="30" as="geometry"/></mxCell><mxCell id="c260" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="80" height="30" as="geometry"/></mxCell><mxCell id="c261" value="&lt;div style=&quot;line-height:1.15&quot;&gt;&lt;b&gt;5%&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#5B6470&quot;&gt;23 tys. zł&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1340" y="716" width="240" height="40" as="geometry"/></mxCell><mxCell id="c262" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="820" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c263" value="&lt;div style=&quot;line-height:1.35&quot;&gt;Przy nagrodzie 300 lub 200 tys. zł skalujemy proporcjonalnie — &lt;b&gt;20% na pilotaż z seniorami zostaje&lt;/b&gt;. Treści, kursy otwarte i cała baza pozostają bezpłatne; grant nie kupuje reklam i nie buduje modułów spoza trzech priorytetów.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=23;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="838" width="1656" height="90" as="geometry"/></mxCell><mxCell id="c354" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c355" value="13 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c377" name="14 Czego potrzebujemy"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c356" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c357" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c264" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;ING I EDMAT&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1720" height="34" as="geometry"/></mxCell><mxCell id="c265" value="&lt;div style=&quot;line-height:1.15&quot;&gt;Czego potrzebujemy — i co z tego ma ING&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=48;fontColor=#1B2430;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="96" width="1720" height="120" as="geometry"/></mxCell><mxCell id="c266" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="846" height="500" as="geometry"/></mxCell><mxCell id="c267" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Potrzebujemy&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=28;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="276" width="782" height="50" as="geometry"/></mxCell><mxCell id="c268" value="&lt;div style=&quot;line-height:1.33&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Wsparcia finansowego&lt;/b&gt; — grant wg budżetu ze slajdu 13.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Wsparcia merytorycznego&lt;/b&gt; — warsztaty i mentoring: model organizacji (fundacja z działalnością gospodarczą), wycena abonamentu generatora sprawdzianów, umowy o treści.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Kontaktów&lt;/b&gt; — szkoły i uczelnie, sekcje emerytów ZNP i UTW, firmy z portfolio ING, które szkolą pracowników z matematyki i statystyki.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Promocji&lt;/b&gt; — finał, kanały ING; po naszej stronie: prof. Andrzej Dragan, Wydział Fizyki UW.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="334" width="782" height="410" as="geometry"/></mxCell><mxCell id="c269" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="974" y="250" width="846" height="500" as="geometry"/></mxCell><mxCell id="c270" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Co z tego ma ING&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=28;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1006" y="276" width="782" height="50" as="geometry"/></mxCell><mxCell id="c271" value="&lt;div style=&quot;line-height:1.33&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:30px&quot;&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Edukację finansową, która nie jest reklamą&lt;/b&gt; — zadania i kurs sprawdzane jak matematyka, przez młodych ekonomistów i seniorów-recenzentów.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Zasięg międzypokoleniowy&lt;/b&gt; w jednym produkcie: uczeń, rodzic (także pracownik ING), dziadek.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Mierzalne, publiczne rezultaty&lt;/b&gt; — liczby ze slajdu 12 publikujemy co kwartał.&lt;/li&gt;&lt;li style=&quot;margin:0 0 12px 0&quot;&gt;&lt;b&gt;Rolę partnera strategicznego ścieżki finansowej&lt;/b&gt; — mecenat, nie reklama: z nazwiskiem recenzenta, nie z logo produktu.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1006" y="334" width="782" height="410" as="geometry"/></mxCell><mxCell id="c272" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="776" width="1720" height="176" as="geometry"/></mxCell><mxCell id="c273" value="&lt;div style=&quot;line-height:1.36&quot;&gt;&lt;b&gt;Utrzymanie po grancie, realistycznie:&lt;/b&gt; treści zawsze bezpłatne. Nie liczymy na hosting dla szkół ani na prowizje od korepetycji. Trzy źródła: &lt;b&gt;(1)&lt;/b&gt; mecenat i CSR partnerów ścieżki finansowej i technologicznej; &lt;b&gt;(2)&lt;/b&gt; granty instytucjonalne na edukację cyfrową i integrację międzypokoleniową — FERS, NCBR, programy MEN; &lt;b&gt;(3)&lt;/b&gt; freemium: generator unikalnych sprawdzianów i kartkówek z bazy, z rozwiązaniami sprawdzonymi przez ludzi, za symboliczny abonament szkoły lub rady rodziców.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#1B2430;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="132" y="792" width="1656" height="150" as="geometry"/></mxCell><mxCell id="c358" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022"