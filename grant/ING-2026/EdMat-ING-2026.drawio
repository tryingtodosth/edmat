;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="536" y="250" width="412" height="260" as="geometry"/></mxCell><mxCell id="c201" value="&lt;div style=&quot;line-height:1.05&quot;&gt;321 tys.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=54;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="560" y="272" width="364" height="80" as="geometry"/></mxCell><mxCell id="c202" value="&lt;div style=&quot;line-height:1.25&quot;&gt;zdających maturę w 2026 r. (CKE) — i tyle samo rodziców, którzy szukają czegoś lepszego niż Brainly&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=21;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="560" y="346" width="364" height="154" as="geometry"/></mxCell><mxCell id="c203" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="972" y="250" width="412" height="260" as="geometry"/></mxCell><mxCell id="c204" value="&lt;div style=&quot;line-height:1.05&quot;&gt;10 mln&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=54;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="996" y="272" width="364" height="80" as="geometry"/></mxCell><mxCell id="c205" value="&lt;div style=&quot;line-height:1.25&quot;&gt;osób w wieku 60+, 26,6% ludności (GUS 2024) — w tym emerytowani nauczyciele i wykładowcy&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=21;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="996" y="346" width="364" height="154" as="geometry"/></mxCell><mxCell id="c206" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F1F0;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1408" y="250" width="412" height="260" as="geometry"/></mxCell><mxCell id="c207" value="&lt;div style=&quot;line-height:1.05&quot;&gt;125,9 tys.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=54;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1432" y="272" width="364" height="80" as="geometry"/></mxCell><mxCell id="c208" value="&lt;div style=&quot;line-height:1.25&quot;&gt;słuchaczy 747 uniwersytetów trzeciego wieku (GUS 2024/25) — nasze wejście do seniorów&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=21;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1432" y="346" width="364" height="154" as="geometry"/></mxCell><mxCell id="c209" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="550" width="554" height="250" as="geometry"/></mxCell><mxCell id="c210" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Pierwszy krąg — 2026/27&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="128" y="574" width="498" height="44" as="geometry"/></mxCell><mxCell id="c211" value="&lt;div style=&quot;line-height:1.35&quot;&gt;Wydział Fizyki UW i kierunki matematyczne: kilka tysięcy studentów, do których docieramy przez prowadzących zajęcia, nie przez reklamę.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="128" y="622" width="498" height="170" as="geometry"/></mxCell><mxCell id="c212" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="682" y="550" width="554" height="250" as="geometry"/></mxCell><mxCell id="c213" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Drugi krąg — 2027&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="710" y="574" width="498" height="44" as="geometry"/></mxCell><mxCell id="c214" value="&lt;div style=&quot;line-height:1.35&quot;&gt;Licea w Warszawie (matura rozszerzona z matematyki i fizyki), uniwersytety trzeciego wieku w trzech miastach, studenci z Ukrainy przez wersje językowe treści.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="710" y="622" width="498" height="170" as="geometry"/></mxCell><mxCell id="c215" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3F6F6;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1264" y="550" width="554" height="250" as="geometry"/></mxCell><mxCell id="c216" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Trzeci krąg — 2028&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=24;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1292" y="574" width="498" height="44" as="geometry"/></mxCell><mxCell id="c217" value="&lt;div style=&quot;line-height:1.35&quot;&gt;Każda szkoła, w której nauczyciel generuje sprawdziany z bazy, i każda uczelnia, która uruchomi własną, bezpłatną kopię — to zasięg. Skąd pieniądze na utrzymanie: slajd 14.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#2B3440;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1292" y="622" width="498" height="170" as="geometry"/></mxCell><mxCell id="c218" value="&lt;div style=&quot;line-height:1.3&quot;&gt;Wiemy, kogo nie obsługujemy w 2027: dzieci poniżej 12 lat inaczej niż przez konto opiekuna i treści dobrane przez dorosłego. Pasmo „najmłodsi” istnieje w modelu, ale nie obiecujemy dla niego produktu w tym grancie.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=22;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="1720" height="90" as="geometry"/></mxCell><mxCell id="c346" value="EdMat.net · Program Grantowy ING „W rytmie pokoleń” · Liga Seed · wrzesień 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="1022" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c347" value="11 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#5B6470;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1620" y="1022" width="200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c375" name="12 Kamienie milowe"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c348" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c349" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F7A78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="14" height="1080" as="geometry"/></mxCell><mxCell id="c219" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;KAMIENIE MILOWE&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#1F7A78;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" pare